# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp

# Env / secrets
.env
.env.*
!.env.example

# Logs / temp
*.log
*.tmp

# Node
node_modules/
npm-debug.log
yarn-error.log

# Build output. NÃO versionado: o que o Obsidian instala vem da GitHub
# Release, que o workflow builda do zero a cada tag — o README manda baixar
# de lá, e a revisão automática rebuilda a fonte pra conferir byte a byte.
# Versionado, ele só fazia cada achado do lint de CSS ser contado duas vezes.
output/

# Config local (vault path do dev, etc.)
.axxa.local.json

# Config do vault Obsidian de teste (não faz parte do plugin)
.obsidian/

# Docs internos de orientação / planejamento (NÃO fazem parte do repo público
# nem da submissão ao Obsidian). Continuam no disco do dev, só saem do git.
# README.md é público e fica tracked.
ACTION-PLAN.md
AGENTS.md
QA-CHECKLIST.md
DESIGN-SYSTEM.md
MASTER-PLAN.md
PROMPT-MESTRE.md
VIABILIDADE-FINANCEIRA.md


# preview da casca (npm run preview): bundle + o app.css extraido do
# Obsidian instalado. O app.css e do app, nao pode ser versionado.
scripts/preview/.out/

# storybook build (gerado por `npm run storybook`)
storybook/dist/
storybook-static/
.sb-shots/

# Credenciais do túnel Cloudflare (TunnelSecret — NUNCA versionar)
cloudflared/

# audit/reconcile scratch (não versionar)
.audit-*.cjs
.audit-*.mjs
.recon-*.json
.recon-*.cjs

# helper temporario de screenshot do storybook (container Linux)
scripts/_shot.cjs
